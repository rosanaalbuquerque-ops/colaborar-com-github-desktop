# ==============================
# OBJETIVO: BASE PARA DASHBOARD
# ==============================
library(dplyr)
library(tidyr)
library(stringr)
### ler o banco de dados
dados <- read.csv("C:/Users/rosana.albuquerque_a/Downloads/Cópia de Informações Gerais - PDSIs - DSEIs.csv",
sep = ",",
fileEncoding = "UTF-8")
# Verificar estrutura
glimpse(dados)
# verificar variaveis
head(dados)
# Nome das variaveis
names(dados)
library(dplyr)
library(stringr)
library(tidyr)
# Separador robusto (vírgula, ;, /, :)
sep_multi <- "\\s*[,;/:]\\s*"
# Limpeza de colunas etnia
dsei_etnias <- dados %>%
mutate(etnias = Etnias..Povos.atendidos. %>%
# remover "SÃO 20:", "SÃO 16:", "ETNIAS:"
str_remove_all("SÃO\\s*\\d+:") %>%
str_remove_all("ETNIAS:") %>%
# remover números soltos
str_remove_all("\\d+") %>%
# remover quebra de linha
str_replace_all("\\n", " ") %>%
# remover " E " como conector
str_replace_all("\\s+E\\s+", ", ") %>%
str_squish()
) %>%
# separar em linhas
separate_rows(etnias, sep = sep_multi) %>%
# limpeza final
mutate(etnias = str_squish(etnias)) %>%
filter(etnias != "") %>%
distinct()
### limpando ainda mais
library(dplyr)
library(stringr)
library(tidyr)
dsei_etnias <- dados %>%
mutate(etnias_povos_atendidos = etnias_povos_atendidos %>%
# remover "SÃO 20:" etc
str_remove_all("SÃO\\s*\\d+:") %>%
# remover qualquer número
str_remove_all("\\d+") %>%
# remover percentuais e km²
str_remove_all("\\d+,?\\d*%") %>%
str_remove_all("Km²") %>%
# remover quebras de linha
str_replace_all("\\n", " ") %>%
# trocar " E " por vírgula
str_replace_all("\\s+E\\s+", ", ") %>%
str_squish()
) %>%
# separar em linhas por vírgula
separate_rows(etnias_povos_atendidos, sep = ",") %>%
mutate(etnias_povos_atendidos = str_squish(etnias_povos_atendidos)) %>%
# manter só linhas com letras (descarta NA, números, etc)
filter(str_detect(etnias_povos_atendidos, "[A-Za-zÁ-Ú]")) %>%
distinct()
